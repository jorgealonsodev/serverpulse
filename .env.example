# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=serverpulse
POSTGRES_PASSWORD=serverpulse
POSTGRES_DB=serverpulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DATABASE_URL (constructed from POSTGRES_* vars above)
DATABASE_URL=postgresql+asyncpg://serverpulse:serverpulse@postgres:5432/serverpulse

# ============================================
# Redis
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# Authentication
# ============================================
# JWT_SECRET must be at least 32 bytes (256 bits) for HS256
JWT_SECRET=change-me-minimum-32-bytes-long-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# ============================================
# Agent
# ============================================
AGENT_TOKEN_SALT=serverpulse-agent-salt
